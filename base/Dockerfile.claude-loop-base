FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    curl git unzip wget \
    ripgrep build-essential cmake ninja-build gdb clang \
    autoconf automake libtool pkg-config \
    python3 python3-pip python3-dev python3-venv \
    less file findutils \
    nodejs npm \
    vim tmux htop procps jq tree fzf openssh-client iproute2 \
    strace valgrind \
    netcat-openbsd tcpdump socat \
    libreadline-dev \
    libssl-dev zlib1g-dev libbz2-dev libsqlite3-dev libffi-dev libncurses-dev liblzma-dev \
    qt6-base-dev qt6-tools-dev qt6-tools-dev-tools qt6-declarative-dev \
    libqt6svg6-dev libqt6opengl6-dev \
    libfontconfig1-dev libfreetype6-dev libgles2-mesa-dev libxcb-util-dev \
    xvfb fluxbox scrot imagemagick x11-utils xdotool xterm \
    libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-sync1 \
    libxcb-xfixes0 libxcb-xinerama0 libxcb-xkb1 libxkbcommon-x11-0 \
    libgl1 libegl1 libdbus-1-3 dbus-x11 libfontconfig1 fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

RUN apt-get update && apt-get install -y openjdk-25-jdk-headless && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-25-openjdk-amd64
ENV PATH="${PATH}:${JAVA_HOME}/bin"
