FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    curl git unzip wget \
    ripgrep build-essential cmake gdb clang \
    python3 python3-pip \
    less file findutils \
    nodejs npm \
    vim tmux htop procps jq tree fzf openssh-client iproute2 \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

RUN apt-get update && apt-get install -y openjdk-25-jdk-headless && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-25-openjdk-amd64
ENV PATH="${PATH}:${JAVA_HOME}/bin"
